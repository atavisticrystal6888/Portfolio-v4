{
  "$schema": "portfolio-v4 design tokens, keyed by CSS custom property name",
  "source": "src/styles/tokens.css",
  "themeAttribute": {
    "attribute": "data-theme",
    "values": [
      "light",
      "dark"
    ],
    "default": "light",
    "storageKey": "ds-portfolio-theme",
    "storageShape": {
      "mode": "light|dark",
      "palette": "teal"
    }
  },
  "fonts": {
    "--font-display": "'Fraunces', 'Fraunces Fallback', 'Iowan Old Style', 'Palatino Linotype', 'Book Antiqua', Georgia, serif",
    "--font-body": "'Manrope', 'Manrope Fallback', 'Aptos', 'Segoe UI Variable Text', 'Segoe UI', 'Helvetica Neue', Arial, sans-serif",
    "--font-mono": "'JetBrains Mono', 'JetBrains Mono Fallback', 'SFMono-Regular', 'Cascadia Code', 'Fira Code', monospace"
  },
  "colors": {
    "--bg": {
      "light": "#f6f5f1",
      "dark": "#0d1322"
    },
    "--bg-alt": {
      "light": "#efede6",
      "dark": "#101828"
    },
    "--surface": {
      "light": "#fcfbf8",
      "dark": "#141c30"
    },
    "--surface-hover": {
      "light": "#f1efe9",
      "dark": "#1a2440"
    },
    "--surface-raised": {
      "light": "#ffffff",
      "dark": "#1c2740"
    },
    "--text": {
      "light": "#24262b",
      "dark": "#d6dae6"
    },
    "--text-strong": {
      "light": "#14161a",
      "dark": "#eef0f7"
    },
    "--text-muted": {
      "light": "#5c5f66",
      "dark": "#8f96aa"
    },
    "--text-body": {
      "light": "#24262b",
      "dark": "#d6dae6"
    },
    "--accent": {
      "light": "#2137c4",
      "dark": "#8fa2ff"
    },
    "--accent-hover": {
      "light": "#1a2ca0",
      "dark": "#a9b8ff"
    },
    "--accent-contrast": {
      "light": "#ffffff",
      "dark": "#0d1322"
    },
    "--accent-glow": {
      "light": "rgba(33, 55, 196, 0.1)",
      "dark": "rgba(143, 162, 255, 0.15)"
    },
    "--accent-subtle": {
      "light": "rgba(33, 55, 196, 0.06)",
      "dark": "rgba(143, 162, 255, 0.08)"
    },
    "--metric": {
      "light": "#14161a",
      "dark": "#eef0f7"
    },
    "--metric-bg": {
      "light": "rgba(33, 55, 196, 0.05)",
      "dark": "rgba(143, 162, 255, 0.07)"
    },
    "--metric-border": {
      "light": "rgba(33, 55, 196, 0.35)",
      "dark": "rgba(143, 162, 255, 0.4)"
    },
    "--success": {
      "light": "#13773a",
      "dark": "#4ade80"
    },
    "--error": {
      "light": "#bb2c2c",
      "dark": "#f87171"
    },
    "--info": {
      "light": "#2137c4",
      "dark": "#7cb3ff"
    },
    "--border": {
      "light": "#d8d5cb",
      "dark": "rgba(214, 222, 255, 0.1)"
    },
    "--border-strong": {
      "light": "#b9b5a7",
      "dark": "rgba(214, 222, 255, 0.18)"
    },
    "--border-accent": {
      "light": "rgba(33, 55, 196, 0.35)",
      "dark": "rgba(143, 162, 255, 0.35)"
    },
    "--nav-bg": {
      "light": "rgba(246, 245, 241, 0.88)",
      "dark": "rgba(13, 19, 34, 0.85)"
    },
    "--glass-bg": {
      "light": "rgba(252, 251, 248, 0.7)",
      "dark": "rgba(20, 28, 48, 0.6)"
    },
    "--glass-border": {
      "light": "#d8d5cb",
      "dark": "rgba(214, 222, 255, 0.12)"
    },
    "--badge-current-bg": {
      "light": "rgba(33, 55, 196, 0.08)",
      "dark": "rgba(143, 162, 255, 0.14)"
    },
    "--badge-current-text": {
      "light": "#1a2ca0",
      "dark": "#8fa2ff"
    },
    "--chip-bg": {
      "light": "rgba(20, 22, 26, 0.04)",
      "dark": "rgba(214, 222, 255, 0.05)"
    },
    "--chip-border": {
      "light": "rgba(20, 22, 26, 0.12)",
      "dark": "rgba(214, 222, 255, 0.12)"
    },
    "--border-control": {
      "light": "#8c8778",
      "dark": "#6b7390"
    },
    "--shadow-sm": {
      "light": "0 1px 2px rgba(30, 30, 20, 0.06)",
      "dark": "0 1px 2px rgba(4, 8, 18, 0.3)"
    },
    "--shadow-md": {
      "light": "0 4px 12px rgba(30, 30, 20, 0.08)",
      "dark": "0 4px 12px rgba(4, 8, 18, 0.4)"
    },
    "--shadow-lg": {
      "light": "0 8px 30px rgba(30, 30, 20, 0.1)",
      "dark": "0 8px 30px rgba(4, 8, 18, 0.5)"
    },
    "--shadow-glow": {
      "light": "0 0 40px rgba(33, 55, 196, 0.08)",
      "dark": "0 0 40px rgba(143, 162, 255, 0.12)"
    },
    "--gradient-text": {
      "light": "linear-gradient(135deg, #2137c4, #14161a)",
      "dark": "linear-gradient(135deg, #8fa2ff, #eef0f7)"
    },
    "--gradient-card": {
      "light": "linear-gradient(135deg, rgba(33, 55, 196, 0.04), rgba(20, 22, 26, 0.02))",
      "dark": "linear-gradient(135deg, rgba(143, 162, 255, 0.06), rgba(238, 240, 247, 0.02))"
    },
    "--gradient-hero": {
      "light": "radial-gradient(ellipse at 50% 0%, rgba(33, 55, 196, 0.05) 0%, transparent 60%)",
      "dark": "radial-gradient(ellipse at 50% 0%, rgba(143, 162, 255, 0.09) 0%, transparent 60%)"
    },
    "--particle-color": {
      "light": "#2137c4",
      "dark": "#8fa2ff"
    },
    "--cursor-color": {
      "light": "#2137c4",
      "dark": "#8fa2ff"
    },
    "--code-bg": {
      "light": "#f1efe8",
      "dark": "#111a2e"
    },
    "--code-border": {
      "light": "rgba(20, 22, 26, 0.1)",
      "dark": "rgba(214, 222, 255, 0.08)"
    },
    "--code-text": {
      "light": "#24292f",
      "dark": "#c9d1d9"
    },
    "--code-comment": {
      "light": "#6e7781",
      "dark": "#6e7681"
    },
    "--code-keyword": {
      "light": "#cf222e",
      "dark": "#ff7b72"
    },
    "--code-string": {
      "light": "#0a3069",
      "dark": "#a5d6ff"
    },
    "--code-function": {
      "light": "#8250df",
      "dark": "#d2a8ff"
    },
    "--code-number": {
      "light": "#0550ae",
      "dark": "#79c0ff"
    },
    "--callout-tip-bg": {
      "light": "rgba(34, 197, 94, 0.06)",
      "dark": "rgba(74, 222, 128, 0.08)"
    },
    "--callout-tip-border": {
      "light": "rgba(34, 197, 94, 0.3)",
      "dark": "rgba(74, 222, 128, 0.3)"
    },
    "--callout-tip-icon": {
      "light": "#15803d",
      "dark": "#4ade80"
    },
    "--callout-warning-bg": {
      "light": "rgba(154, 106, 16, 0.06)",
      "dark": "rgba(234, 177, 68, 0.08)"
    },
    "--callout-warning-border": {
      "light": "rgba(154, 106, 16, 0.3)",
      "dark": "rgba(234, 177, 68, 0.3)"
    },
    "--callout-warning-icon": {
      "light": "#9a6a10",
      "dark": "#eab144"
    },
    "--callout-info-bg": {
      "light": "rgba(33, 55, 196, 0.05)",
      "dark": "rgba(124, 179, 255, 0.08)"
    },
    "--callout-info-border": {
      "light": "rgba(33, 55, 196, 0.3)",
      "dark": "rgba(124, 179, 255, 0.3)"
    },
    "--callout-info-icon": {
      "light": "#2137c4",
      "dark": "#7cb3ff"
    },
    "--process-step-1": {
      "light": "#2137c4",
      "dark": "#8fa2ff"
    },
    "--process-step-2": {
      "light": "#9a6a10",
      "dark": "#eab144"
    },
    "--process-step-3": {
      "light": "#15803d",
      "dark": "#4ade80"
    },
    "--process-step-4": {
      "light": "#6d4fc4",
      "dark": "#d2a8ff"
    },
    "--process-connector": {
      "light": "rgba(20, 22, 26, 0.14)",
      "dark": "rgba(214, 222, 255, 0.12)"
    },
    "--divider-opacity": {
      "light": "0.1",
      "dark": "0.08"
    }
  },
  "type": {
    "scale": {
      "--text-xs": "0.75rem",
      "--text-sm": "0.875rem",
      "--text-base": "1rem",
      "--text-lg": "1.125rem",
      "--text-xl": "1.375rem",
      "--text-2xl": "1.875rem",
      "--text-3xl": "2.75rem",
      "--text-4xl": "3.5rem",
      "--text-display": "clamp(2.75rem, 6vw, 4.5rem)",
      "--text-hero": "clamp(2.9rem, 7vw, 5.25rem)"
    },
    "leading": {
      "--leading-tight": "1.1",
      "--leading-snug": "1.3",
      "--leading-body": "1.65"
    },
    "tracking": {
      "--tracking-tight": "-0.02em",
      "--tracking-label": "0.14em"
    },
    "measures": {
      "--measure-prose": "68ch",
      "--measure-lede": "56ch"
    },
    "headingDefaults": {
      "h1": "clamp(2.6rem, 5.5vw, 4.2rem) / 700 / -0.02em (base.css)",
      "h2": "clamp(1.8rem, 3.5vw, 2.8rem) / 700 / -0.01em (base.css)",
      "h3": "clamp(1.1rem, 2vw, 1.4rem) / 700 (base.css)",
      "h4": "var(--text-lg) / 600 (base.css)",
      "pageTitle": "clamp(var(--text-2xl), 5vw, var(--text-4xl)) / 700 / --tracking-tight / --leading-tight (PageHeader, ProductMasthead)",
      "sectionTitle": "clamp(var(--text-xl), 3vw, var(--text-2xl)) / 700 / --tracking-tight / --leading-tight (section.module.css)",
      "fieldLabel": "var(--font-mono) / var(--text-xs) / 500 / uppercase / --tracking-label (SectionLabel, Badge, rails, breadcrumbs)"
    }
  },
  "spacing": {
    "--space-1": "4px",
    "--space-2": "8px",
    "--space-3": "12px",
    "--space-4": "16px",
    "--space-5": "20px",
    "--space-6": "24px",
    "--space-7": "32px",
    "--space-8": "40px",
    "--space-9": "48px",
    "--space-10": "64px",
    "--space-11": "80px",
    "--space-12": "100px",
    "--space-14": "120px",
    "--section-gap": "clamp(96px, 12vh, 160px)"
  },
  "radii": {
    "--radius-sm": "6px",
    "--radius-md": "10px",
    "--radius-lg": "14px",
    "--radius-xl": "20px",
    "--radius-2xl": "28px",
    "--radius-full": "100px",
    "--radius-pill": "100px",
    "--radius-editorial": "4px"
  },
  "rules": {
    "--hairline": "1px solid var(--border)",
    "--rule-strong": "1px solid var(--border-strong)"
  },
  "focus": {
    "--focus-offset": "3px",
    "ring": "2px solid var(--accent)",
    "cornerOnGlobalRule": "var(--radius-sm)"
  },
  "transitions": {
    "--transition-fast": "0.15s ease",
    "--transition-base": "0.25s ease",
    "--transition-slow": "0.4s ease",
    "--transition-theme": "0.3s ease"
  },
  "layout": {
    "--container-max": "1120px",
    "--container-wide": "1200px",
    "--container-md": "760px",
    "--nav-height": "64px",
    "--page-header-height": "280px",
    "--sidebar-width": "260px",
    "--reading-width": "680px",
    "--toc-width": "220px"
  },
  "zIndex": {
    "--z-base": "1",
    "--z-dropdown": "100",
    "--z-sticky": "500",
    "--z-overlay": "900",
    "--z-modal": "1000",
    "--z-toast": "1100",
    "--z-cursor": "9999"
  },
  "touchTarget": "44px min-height and min-width on button, a, input, [role=button] (base.css); inline text links exempt"
}
